# Everything ships to Linux containers/servers: keep LF line endings in the repo
# and in the working tree, regardless of the developer's OS or core.autocrlf.
* text=auto eol=lf

# Windows-only helper scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.tar binary
*.gz binary
