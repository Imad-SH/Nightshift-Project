# Nightshift configuration.
#
# install.sh creates nightshift.env from this file and fills in every secret with a
# random value. Keep nightshift.env private (it is created readable by root only)
# and include it in your backups: NIGHTSHIFT_SECRET_KEY encrypts the API keys stored
# in the database, and they cannot be recovered without it.

# --- Address --------------------------------------------------------------------
# The address analysts open in their browser. Also used for login redirects.
NIGHTSHIFT_PUBLIC_URL=https://soc.example.local
HTTPS_PORT=443
HTTP_PORT=80

# true: Nightshift terminates TLS with certs/server.crt and certs/server.key
#       (install.sh generates a self-signed certificate if none is provided).
# false: a reverse proxy or load balancer in front terminates TLS and forwards
#        plain HTTP to HTTP_PORT (it must set X-Forwarded-Proto).
TLS_ENABLED=true

# Keycloak's own admin console at /auth/admin (e.g. to connect Active Directory).
# Leave disabled unless you need it.
KEYCLOAK_ADMIN_CONSOLE=disabled

# --- Version (set by install.sh / upgrade.sh) -----------------------------------
NIGHTSHIFT_VERSION=
# Registry the images were downloaded from, e.g. registry.example.com/bluesec/
# (empty: images loaded from the package). Set by install.sh / upgrade.sh.
NIGHTSHIFT_REGISTRY=

# --- Secrets (generated by install.sh) ------------------------------------------
NIGHTSHIFT_SECRET_KEY=
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
REDIS_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# --- Branding (optional) ---------------------------------------------------------
# VENDOR_NAME=BlueSec
# PRODUCT_NAME=Nightshift
