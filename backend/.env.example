# BlueSec Nightshift backend configuration.
# Copy to .env for local development. In production these values come from the
# installer's config file and are passed to the container as environment variables.

# --- Server ---------------------------------------------------------------
DEBUG=false

# Encrypts API keys and passwords stored in the database (Fernet key).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy somewhere safe: if it is lost, stored keys have to be re-entered in the UI.
NIGHTSHIFT_SECRET_KEY=

# --- Database (PostgreSQL) --------------------------------------------------
POSTGRES_SERVER=postgres
POSTGRES_USER=nightshift
POSTGRES_PASSWORD=
POSTGRES_DB=nightshift

# --- Cache (Redis) ----------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Identity (Keycloak) ----------------------------------------------------
# Address the backend uses to reach Keycloak (an internal address is fine).
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=nightshift
KEYCLOAK_CLIENT_ID=bluesec-frontend
# Keycloak admin account, used by the Users screen to manage accounts.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# --- Branding (optional white-label) ----------------------------------------
# VENDOR_NAME=BlueSec
# PRODUCT_NAME=Nightshift

# --- Integrations, LLM and CTI keys -------------------------------------------
# Normally entered by an admin in the UI, where they are stored encrypted.
# Values set here only act as defaults until something is saved in the UI.
# WAZUH_URL=https://wazuh.example.local:55000
# WAZUH_USER=
# WAZUH_PASSWORD=
# FLOWINTEL_URL=
# FLOWINTEL_API_KEY=
# THEHIVE_URL=
# THEHIVE_API_KEY=
# NEBIUS_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# URLSCAN_API_KEY=
# ALIENVAULT_API_KEY=
