# --- Secrets: never commit. Use the matching *.example file instead. ---
.env
.env.*
*.env
!*.env.example
!.env.example

# --- Dependencies / build output ---
node_modules/
dist/
dist-ssr/
.venv/
venv/
__pycache__/
*.py[cod]
*.local

# --- Runtime data & generated files ---
backups/
backend/downloads/
backend/scratch/mitre_cache.json
release/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Dev-machine artifacts (not part of the product) ---
*.zip
*.tar
*.tar.gz
*.7z

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Local debug scripts that contain hardcoded credentials (kept on disk, never committed) ---
tmp_ossec.conf
write_ossec_conf.py
backend/test_fi.py
