# --- Secrets: never commit. Use the matching *.example file instead. ---
.env
.env.*
*.env
!*.env.example
!.env.example

# --- Dependencies / build output ---
node_modules/
dist/
dist-ssr/
.venv/
venv/
__pycache__/
*.py[cod]
*.local

# --- Runtime data & generated files ---
backups/
backend/downloads/
backend/data/
release/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Dev-machine artifacts (not part of the product) ---
*.zip
*.tar
*.tar.gz
*.7z

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Developer-machine files: local Wazuh/Flowintel configs, one-off debug scripts ---
_local/
