# Wazuh - Filebeat configuration file
filebeat.modules:
  - module: wazuh
    alerts:
      enabled: true
    archives:
      enabled: false

setup.template.json.enabled: true
setup.template.overwrite: true
setup.template.json.path: '/etc/filebeat/wazuh-template.json'
setup.template.json.name: 'wazuh'
setup.ilm.enabled: false
output.elasticsearch:
  hosts: ['https://172.50.0.2:9200']
  username: 'admin'
  password: 'admin'
  ssl.verification_mode: full
  ssl.certificate_authorities: ["/var/ossec/etc/certs/root-ca.pem"]
  ssl.certificate: "/var/ossec/etc/certs/wazuh.manager.pem"
  ssl.key: "/var/ossec/etc/certs/wazuh.manager-key.pem"

logging.metrics.enabled: false

seccomp:
  default_action: allow
  syscalls:
  - action: allow
    names:
    - rseq
